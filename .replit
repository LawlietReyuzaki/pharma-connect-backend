modules = ["python-3.11", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["ffmpeg", "ffmpeg-full", "openssl", "postgresql", "unzip"]

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind 0.0.0.0:5000 --reuse-port --reload main:app"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[agent]
integrations = ["flask_google_oauth:1.0.0", "python_openai:1.0.0", "python_database:1.0.0"]

[userenv]

[userenv.shared]
LLM_PROVIDER = "gemini"
GEMINI_MODEL = "gemini-2.0-flash"
GEMINI_TEMPERATURE = "0.7"
